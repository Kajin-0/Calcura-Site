{
  "name": "calcura-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "test": "npm run test:classroom-entry && npm run test:download-chooser-a11y && npm run test:site-quality && npm run test:deployment-gates",
    "test:download-chooser-a11y": "node tests/download-chooser-a11y-regression.cjs && node tests/pwa-install-entry-regression.cjs",
    "test:classroom-entry": "node tests/classroom-production-entry-regression.cjs",
    "test:site-quality": "node tests/site-quality-regression.cjs",
    "test:built-site": "node tests/built-site-regression.cjs",
    "test:deployment-gates": "node tests/deployment-gates-regression.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/stix-two-text": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "vite": "^7.1.4"
  }
}
